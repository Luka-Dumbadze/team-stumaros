# Copy to .env in this folder (git-ignored) and fill in ONE key. Never put a real key in this file.
# Precedence: GEMINI_API_KEY, then OPENROUTER_API_KEY; with neither set the CLI runs the offline mock.

# Google AI Studio key -> OpenAI-compatible endpoint, default model gemini-3.8-flash
GEMINI_API_KEY=

# OpenRouter key -> default model google/gemini-3.8-flash (used only if GEMINI_API_KEY is empty)
OPENROUTER_API_KEY=
